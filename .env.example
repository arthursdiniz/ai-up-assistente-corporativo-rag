APP_NAME=AI-Up
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_up
# Alternativa recomendada no Windows: deixe DATABASE_URL apenas como fallback e
# defina DATABASE_USERNAME e DATABASE_PASSWORD nas variáveis de ambiente do usuário.
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ai_up

SECRET_KEY=SUBSTITUIR_POR_UMA_CHAVE_LOCAL_SEGURA
ACCESS_TOKEN_EXPIRE_MINUTES=480

UPLOAD_DIR=./data/uploads
CHROMA_DIR=./data/chroma
MAX_UPLOAD_SIZE_MB=20

CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_MIN_RELEVANCE=0.25
RAG_BROAD_TOP_K=8
RAG_BROAD_MIN_RELEVANCE=0.18
RAG_CANDIDATE_POOL=20
RAG_SEMANTIC_WEIGHT=0.65
RAG_SEMANTIC_ONLY_MIN_RELEVANCE=0.50
RAG_LEXICAL_SCAN_LIMIT=5000
CONVERSATION_HISTORY_MESSAGES=6
CONVERSATION_HISTORY_CHAR_LIMIT=6000

LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct

EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

TESSERACT_CMD=
